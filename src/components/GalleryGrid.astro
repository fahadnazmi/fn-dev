---
import { Image } from "astro:assets";

// Drop photos into src/assets/photos/ and they appear here automatically.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp,avif}",
  { eager: true }
);

const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    src: mod.default,
    alt: path.split("/").pop()?.replace(/\.[^.]+$/, "").replace(/[-_]/g, " ") ?? "Photograph",
  }));
---

{
  photos.length === 0 ? (
    <p class="muted">No photos yet. Add images to <code>src/assets/photos/</code>.</p>
  ) : (
    <div class="grid">
      {photos.map((p) => (
        <figure data-reveal>
          <Image src={p.src} alt={p.alt} widths={[400, 800, 1200]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" />
        </figure>
      ))}
    </div>
  )
}

<style>
  .grid {
    columns: 1;
    column-gap: 1rem;
  }
  @media (min-width: 600px) {
    .grid {
      columns: 2;
    }
  }
  @media (min-width: 1000px) {
    .grid {
      columns: 3;
    }
  }
  figure {
    margin: 0 0 1rem;
    break-inside: avoid;
    overflow: hidden;
  }
  img {
    width: 100%;
    height: auto;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  figure:hover img {
    transform: scale(1.04);
  }
</style>
