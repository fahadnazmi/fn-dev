
---
import { site } from "../data/site";
const path = Astro.url.pathname;
---

<header>
  <a href="/" class="logo">{site.name}</a>
</header>

<nav class="nav-overlay">
  {
    site.nav.map((item) => (
      <a
        href={item.href}
        aria-current={path.startsWith(item.href) ? "page" : undefined}
      >
        {item.label}
      </a>
    ))
  }
</nav>

<style>
  header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem var(--gutter);
    color: white;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .logo {
    pointer-events: auto;
    font-color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: bold;
    letter-spacing: -0.05em;
  }

  .nav-overlay {
    position: fixed;
    top: 1.25rem;
    right: var(--gutter);
    z-index: 11;
    display: flex;
    gap: 3rem;
    font-size: 0.9rem;
    font-weight: thin;
    letter-spacing: -0.05em;
    color: var(--muted);
    mix-blend-mode: normal;
  }

  .nav-overlay a {
    transition: color 0.2s ease;
  }

  .nav-overlay a:hover,
  .nav-overlay a[aria-current="page"] {
    color: var(--accent);
    font-weight: bold;
  }
</style>
