---
interface Props {
  slug: string;
  title: string;
  summary: string;
  year: number;
  stack: string[];
}

const { slug, title, summary, year, stack } = Astro.props;
---

<a href={`/work/${slug}`} class="card" data-reveal>
  <span class="year muted">{year}</span>
  <h3>{title}</h3>
  <p class="muted">{summary}</p>
  <ul>{stack.map((s) => <li>{s}</li>)}</ul>
</a>

<style>
  .card {
    display: grid;
    gap: 0.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--line);
    transition: padding-left 0.4s ease;
  }
  .card:hover {
    padding-left: 1rem;
  }
  h3 {
    font-size: clamp(1.75rem, 4vw, 3rem);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
  }
  li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
  }
</style>
