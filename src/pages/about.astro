---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
const { about } = site;
const {
  image,
  techStack,
  marqueeDuration,
  marqueeCopies,
  eventStepDegrees,
  timeline,
} = about;

const iconUrl = (tech: { slug?: string; icon?: string }) =>
  tech.icon ?? `https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${tech.slug}.svg`;

const eventAngle = (index: number) => 270 + index * eventStepDegrees;

const timelineMarks = Array.from({ length: 360 }, (_, index) => ({
  angle: (270 + index) % 360,
  kind: index % eventStepDegrees === 0 ? "major" : "minor",
}));
---

<BaseLayout title="About" description={`About ${site.name}`}>
  <section class="about-intro">
    <div class="about-copy">
      <h1 data-split data-split-no-mask>Oh<span class="hero-title-accent">,</span><br />Hey there.</h1>
      <p data-reveal>
        I write code, obsess over details, and think way too hard about things nobody else will ever see. <span class="hero-title-accent">Tech</span> and <span class="hero-title-accent">Design</span> are where I have the most fun,
        mostly because that’s where the tiny details live.
      </p>
    </div>
    <div class="about-image">
      <Picture
        src={image.src}
        alt={image.alt}
        widths={[180, 320, 480, 640, 900]}
        sizes="(max-width: 480px) 30vw, 25vw"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <!-- ---------------------------------------
       TECH STACK
  ---------------------------------------- -->

  {techStack.length > 0 && (
    <section class="tech-section" aria-labelledby="tech-stack-title">
      <h2 id="tech-stack-title" class="tech-title" data-reveal>My Tech Stack</h2>

      <div
        class="tech-marquee"
        style={`--marquee-duration: ${marqueeDuration}s; --marquee-offset: ${-100 / marqueeCopies}%;`}
      >
        <div class="tech-track">
          {Array.from({ length: marqueeCopies }, (_, copyIndex) => (
            <ul class="tech-group" aria-hidden={copyIndex > 0 ? "true" : undefined}>
              {techStack.map((tech) => {
                const Tag = tech.url ? "a" : "div";
                const linkProps = tech.url
                  ? {
                      href: tech.url,
                      target: "_blank",
                      rel: "noopener noreferrer",
                      "aria-label": `${tech.name} (opens in new tab)`,
                      tabindex: copyIndex > 0 ? -1 : undefined,
                    }
                  : {};

                return (
                  <li class="tech-item">
                    <Tag class="tech-link" {...linkProps}>
                      <span
                        class="tech-icon"
                        style={`--icon: url("${iconUrl(tech)}");`}
                        role="img"
                        aria-label={tech.name}
                      ></span>
                      <span class="tech-label" aria-hidden="true">{tech.name}</span>
                    </Tag>
                  </li>
                );
              })}
            </ul>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ---------------------------------------
       TIMELINE
  ---------------------------------------- -->

  {timeline.length > 0 && (
    <section
      class="timeline-section"
      data-timeline
      aria-label="Career and education timeline"
      style={`--event-count: ${timeline.length};`}
      data-event-step={eventStepDegrees}
    >
      <div class="timeline-stage">
        <!-- Circular timeline wheel -->

        <div class="timeline-wheel">
          <div class="wheel-ticks" aria-hidden="true">
            {timelineMarks.map((mark) => (
              <span
                class="wheel-tick"
                data-kind={mark.kind}
                style={`--angle: ${mark.angle}deg;`}
              ></span>
            ))}
          </div>

          <ol class="timeline-points">
            {timeline.map((event, index) => (
              <li
                class="timeline-point"
                data-point={index}
                data-visible={index <= 2 ? "true" : "false"}
                data-active={index === 0 ? "true" : "false"}
                aria-hidden={index > 2 ? "true" : "false"}
                style={`--angle: ${eventAngle(index)}deg;`}
              >
                <button
                  type="button"
                  class="point-content"
                  aria-label={`Show ${event.date}: ${event.title}`}
                  aria-controls={`timeline-detail-${index}`}
                  aria-current={index === 0 ? "step" : undefined}
                >
                  <span class="point-dot"></span>
                </button>
              </li>
            ))}
          </ol>
        </div>

        <!-- Active timeline event -->

        <div class="timeline-content">
          {timeline.map((event, index) => (
            <article
              id={`timeline-detail-${index}`}
              class="timeline-detail"
              data-detail={index}
              data-active={index === 0 ? "true" : "false"}
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <span class="detail-date">{event.date}</span>

              <h2>{event.title}</h2>

              <div class="detail-organization">
                <span>{event.organization}</span>

                {event.location && (
                  <>
                    <span class="meta-separator">/</span>
                    <span>{event.location}</span>
                  </>
                )}
              </div>

              {event.description && <p>{event.description}</p>}
            </article>
          ))}
        </div>

      </div>
    </section>
  )}
</BaseLayout>

<script>
  function initTimeline() {
    const sections = document.querySelectorAll<HTMLElement>("[data-timeline]");

    sections.forEach((section) => {
      const wheel = section.querySelector<HTMLElement>(".timeline-wheel");
      const points = Array.from(section.querySelectorAll<HTMLElement>("[data-point]"));
      const details = Array.from(section.querySelectorAll<HTMLElement>("[data-detail]"));
      const eventStepDegrees = Number(section.dataset.eventStep);
      if (!wheel || !points.length || !eventStepDegrees) return;

      const lastIndex = points.length - 1;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      let targetProgress = 0;
      let currentProgress = 0;
      let animationFrame = 0;
      let activeIndex = -1;

      function updateActiveEvent(progress: number) {
        const nextIndex = Math.round(progress * lastIndex);
        if (nextIndex === activeIndex) return;

        activeIndex = nextIndex;

        points.forEach((point, index) => {
          const active = index === activeIndex;
          const visible = Math.abs(index - activeIndex) <= 2;
          point.dataset.active = String(active);
          point.dataset.visible = String(visible);
          point.setAttribute("aria-hidden", String(!visible));
          const button = point.querySelector<HTMLButtonElement>(".point-content");
          if (active) button?.setAttribute("aria-current", "step");
          else button?.removeAttribute("aria-current");
        });

        details.forEach((detail, index) => {
          const active = index === activeIndex;
          detail.dataset.active = String(active);
          detail.setAttribute("aria-hidden", String(!active));
        });
      }

      let previousFrameTime = 0;

      points.forEach((point, index) => {
        point.querySelector<HTMLButtonElement>(".point-content")?.addEventListener("click", () => {
          const distance = section.offsetHeight - window.innerHeight;
          const sectionTop = window.scrollY + section.getBoundingClientRect().top;
          window.scrollTo({
            top: sectionTop + distance * (lastIndex ? index / lastIndex : 0),
            behavior: reducedMotion ? "auto" : "smooth",
          });
        });
      });

      function render(time: number) {
        const difference = targetProgress - currentProgress;

        if (reducedMotion) {
          currentProgress = targetProgress;
        } else {
          const delta = previousFrameTime ? Math.min(time - previousFrameTime, 64) : 16;
          currentProgress += difference * (1 - Math.exp(-delta / 120));
          if (Math.abs(difference) < 0.0005) currentProgress = targetProgress;
        }
        previousFrameTime = time;
        wheel.style.transform = `translateY(-50%) rotate(${-currentProgress * lastIndex * eventStepDegrees}deg)`;
        updateActiveEvent(currentProgress);

        if (Math.abs(targetProgress - currentProgress) > 0.0005) {
          animationFrame = requestAnimationFrame(render);
        } else animationFrame = 0;
      }

      function updateTarget() {
        const rect = section.getBoundingClientRect();
        const distance = section.offsetHeight - window.innerHeight;
        targetProgress = distance > 0
          ? Math.max(0, Math.min(1, -rect.top / distance))
          : 0;

        if (!animationFrame) {
          animationFrame = requestAnimationFrame(render);
        }
      }

      window.addEventListener("scroll", updateTarget, { passive: true });
      window.addEventListener("resize", updateTarget);

      updateTarget();
    });
  }

  initTimeline();
</script>

<style>
  /* -----------------------------------------
     ABOUT CONTENT
  ----------------------------------------- */

  .about-intro {
    min-height: 45svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 28%);
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
  }

  .about-copy {
    min-width: 0;
  }

  .about-copy p {
    margin-top: 5rem;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 2vw, 1.8rem);
    line-height: 1;
  }

  .about-copy h1 {
    position: relative;
    z-index: 2;
    margin-left: -0.08em;
    font-size: clamp(3.5rem, 16vw, 14rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
  }

  .about-image {
    position: relative;
    z-index: 1;
    width: 85%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    justify-self: start;
    align-self: center;
    transform: translate(
      calc(clamp(8px, 3.5vw, 53px) + clamp(2px, 0.4vw, 6px)),
      clamp(-40px, -2.6vw, -12px)
    );
    clip-path: inset(0 0 0 clamp(12px, 1.65vw, 25px));
  }

  @media (max-width: 768px) {
    .about-intro {
      min-height: 40svh;
      grid-template-columns: minmax(0, 1fr) minmax(0, 30%);
      gap: 1rem;
    }

    .about-copy h1 {
      font-size: clamp(3.5rem, 13vw, 6rem);
    }

    .about-image {
      width: 85%;
      transform: translate(
        clamp(6px, 2vw, 15px),
        clamp(-20px, -2vw, -10px)
      );
    }
  }

  @media (max-width: 480px) {
    .about-intro {
      position: relative;
      min-height: 35svh;
      grid-template-columns: minmax(0, 1fr) minmax(4.5rem, 30%);
      grid-template-rows: auto auto;
      align-items: center;
      column-gap: 0.75rem;
      row-gap: 1.5rem;
      padding-top: 2rem;
    }

    .about-copy {
      display: contents;
    }

    .about-copy h1 {
      grid-column: 1 / -1;
    }

    .about-copy p {
      grid-column: 1;
      margin: 0;
      font-size: clamp(0.9rem, 4vw, 1.05rem);
      line-height: 1.15;
    }

    .about-image {
      z-index: 1;
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
      width: 100%;
      align-self: center;
      margin: 0;
      transform: none;
      clip-path: inset(0);
    }
  }

  @media (max-width: 360px) {
    .about-copy h1 {
      font-size: 3.2rem;
    }
  }

  /* -----------------------------------------
     TECH STACK SECTION
  ----------------------------------------- */

  .tech-section {
    /* Tweak these to restyle every logo at once */
    --tech-logo-size: clamp(2.25rem, 4vw, 3.25rem); /* same size for every logo */
    --tech-gap: clamp(2.5rem, 6vw, 5.5rem);
    --tech-idle: var(--fg);

    margin-top: 8rem;
  }

  .tech-title {
    margin: 0 0 2.5rem;
    font-size: clamp(0.8rem, 1.2vw, 1rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Full-bleed strip with softly faded edges */
  .tech-marquee {
    position: relative;
    overflow: hidden;
    margin-inline: calc(var(--gutter) * -1);
    /* room for the hover label + scale so nothing gets clipped */
    padding-block: 1.25rem 2.75rem;

    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }

  .tech-track {
    display: flex;
    width: max-content;
    animation: tech-scroll var(--marquee-duration, 45s) linear infinite;
    will-change: transform;
  }

  /* Pause the loop while the pointer is over the strip */
  @media (hover: hover) {
    .tech-marquee:hover .tech-track {
      animation-play-state: paused;
    }
  }

  .tech-group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--tech-gap);
    margin: 0;
    padding: 0;
    padding-right: var(--tech-gap);
    list-style: none;
  }

  .tech-item {
    flex-shrink: 0;
  }

  .tech-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tech-logo-size);
    height: var(--tech-logo-size);
    color: var(--tech-idle);
    text-decoration: none;
    outline: none;
    transition:
      color 0.35s ease,
      opacity 0.35s ease,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* The logo is painted with the current colour through a CSS mask,
     so any single-colour SVG follows the site's theme. */
  .tech-icon {
    display: block;
    width: 100%;
    height: 100%;
    background-color: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tech-label {
    position: absolute;
    top: calc(100% + 0.9rem);
    left: 50%;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--fg);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -6px);
    transition:
      opacity 0.3s ease,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hover: logo lights up in the accent colour, lifts and scales,
     the label slides in, and the other logos step back. */
  @media (hover: hover) {
    .tech-marquee:hover .tech-link:not(:hover):not(:focus-visible) {
      opacity: 0.35;
    }

    .tech-link:hover {
      color: var(--accent);
    }

    .tech-link:hover .tech-icon {
      transform: translateY(-6px) scale(1.2);
    }

    .tech-link:hover .tech-label {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .tech-link:focus-visible {
    color: var(--accent);
  }

  .tech-link:focus-visible .tech-icon {
    transform: translateY(-6px) scale(1.2);
  }

  .tech-link:focus-visible .tech-label {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @keyframes tech-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(var(--marquee-offset), 0, 0);
    }
  }

  @media (max-width: 768px) {
    .tech-section {
      margin-top: 6rem;
    }
  }

  @media (max-width: 480px) {
    .tech-section {
      margin-top: 5rem;
    }

    .tech-title {
      margin-bottom: 1.5rem;
    }
  }

  /* Reduced motion: no scrolling, show one static wrapped grid */
  @media (prefers-reduced-motion: reduce) {
    .tech-marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .tech-track {
      width: auto;
      animation: none;
    }

    .tech-group[aria-hidden="true"] {
      display: none;
    }

    .tech-group {
      flex-wrap: wrap;
      padding-inline: var(--gutter);
      row-gap: 2.5rem;
    }

    .tech-link,
    .tech-icon,
    .tech-label {
      transition: none;
    }
  }

  /* -----------------------------------------
     TIMELINE SECTION
  ----------------------------------------- */

  .timeline-section {
    position: relative;
    height: calc(var(--event-count) * 100svh);
    margin-top: 5rem;

    /* Inverted colour scheme */
    background: var(--fg);
    color: var(--bg);

    --timeline-fg: var(--bg);
    --timeline-muted: color-mix(in srgb, var(--bg) 48%, transparent);

    /* Extend the background to the viewport edges */
    margin-inline: calc(var(--gutter) * -1);
  }

  .timeline-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  /* -----------------------------------------
     CIRCULAR WHEEL
  ----------------------------------------- */

  .timeline-wheel {
    --wheel-size: 170vmin;

    position: absolute;
    top: 50%;
    left: 55vw;
    width: var(--wheel-size);
    height: var(--wheel-size);

    transform: translateY(-50%);

    transform-origin: center;
    will-change: transform;
  }

  /* -----------------------------------------
     CLOCK-STYLE MINUTE MARKINGS
  ----------------------------------------- */

  .wheel-ticks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .wheel-tick {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    transform: rotate(var(--angle)) translateY(calc(var(--wheel-size) * -0.495));
  }

  .wheel-tick::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 8px;
    background: color-mix(in srgb, var(--timeline-fg) 24%, transparent);
    content: "";
    transform: translateX(-50%);
  }

  .wheel-tick[data-kind="minor"]::before {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--timeline-fg) 32%, transparent);
    transform: translate(-50%, -50%);
  }

  .wheel-tick[data-kind="major"]::before {
    background: color-mix(in srgb, var(--timeline-fg) 62%, transparent);
  }

  /* -----------------------------------------
     TIMELINE EVENTS
  ----------------------------------------- */

  .timeline-points {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline-point {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    transform: rotate(var(--angle)) translateY(calc(var(--wheel-size) * -0.495));
    transition: visibility 0s linear 280ms;
  }

  .timeline-point[data-visible="true"] {
    transition-delay: 0s;
  }

  .timeline-point[data-visible="false"] {
    visibility: hidden;
    pointer-events: none;
  }

  .point-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.7);
    transition:
      opacity 280ms ease,
      transform 560ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-point[data-visible="true"] .point-content {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .point-content:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: -2px;
    border-radius: 50%;
  }

  .point-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    transform: translate(-50%, -50%);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .point-dot::after {
    position: absolute;
    inset: -7px;
    border: 1px solid color-mix(in srgb, var(--accent) 72%, transparent);
    border-radius: inherit;
    content: "";
    opacity: 0;
    transform: scale(0.6);
  }

  /* Selected event */

  .timeline-point[data-active="true"] .point-content {
    z-index: 1;
  }

  .timeline-point[data-active="true"] .point-dot {
    transform: translate(-50%, -50%) scale(1.5);
  }

  .timeline-point[data-active="true"] .point-dot::after {
    animation: marker-arrive 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .point-content:hover .point-dot {
    transform: translate(-50%, -50%) scale(1.35);
  }

  @keyframes marker-arrive {
    0% {
      opacity: 0.65;
      transform: scale(0.6);
    }

    100% {
      opacity: 0;
      transform: scale(1.7);
    }
  }

  /* -----------------------------------------
     EVENT CONTENT
  ----------------------------------------- */

  .timeline-content {
    position: relative;
    z-index: 3;
    width: min(38vw, 470px);
    margin-left: calc(var(--gutter) + 5rem);
    color: var(--timeline-fg);
    display: grid;
  }

  .timeline-detail {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    opacity: 0;
    visibility: hidden;
    filter: blur(7px);
    transform: translate3d(0, 18px, 0);
    transition:
      opacity 420ms ease,
      filter 520ms ease,
      transform 650ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 520ms;
  }

  .timeline-detail[data-active="true"] {
    opacity: 1;
    visibility: visible;
    filter: blur(0);
    transform: translate3d(0, 0, 0);
    transition-delay: 0s;
  }

  .timeline-detail > * {
    opacity: 0;
    transform: translate3d(0, 10px, 0);
    transition:
      opacity 420ms ease,
      transform 560ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-detail[data-active="true"] > * {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .timeline-detail[data-active="true"] .detail-date {
    transition-delay: 40ms;
  }

  .timeline-detail[data-active="true"] h2 {
    transition-delay: 90ms;
  }

  .timeline-detail[data-active="true"] .detail-organization {
    transition-delay: 140ms;
  }

  .timeline-detail[data-active="true"] p {
    transition-delay: 190ms;
  }

  .detail-date {
    font-size: clamp(3.5rem, 7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
    color: var(--accent);
  }

  .timeline-detail h2 {
    max-width: 13ch;
    margin-top: 1.5rem;

    font-size: clamp(1.7rem, 3vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
    color: var(--timeline-fg);
  }

  .detail-organization {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;

    font-size: 0.85rem;
    color: var(--timeline-fg);
  }

  .meta-separator {
    color: var(--timeline-muted);
  }

  .timeline-detail p {
    max-width: 40ch;
    margin-top: 1.5rem;

    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--timeline-muted);
  }

  /* -----------------------------------------
     TABLET
  ----------------------------------------- */

  @media (max-width: 768px) {
    .timeline-section {
      margin-top: 8rem;
    }

    .timeline-stage {
      min-height: 550px;
    }

    .timeline-wheel {
      --wheel-size: 160vmin;
      left: 55vw;
