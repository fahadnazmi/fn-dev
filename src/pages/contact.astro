---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
---

<BaseLayout title="Contact" description="Get in touch.">
  <h1 data-split>Contact</h1>

  <p class="muted" data-reveal>
    <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
  </p>

  {
    endpoint && (
      <form action={endpoint} method="POST" data-reveal>
        <label>Name <input name="name" required /></label>
        <label>Email <input type="email" name="email" required /></label>
        <label>Message <textarea name="message" rows="5" required></textarea></label>
        <button type="submit">Send</button>
      </form>
    )
  }
</BaseLayout>

<style>
  html {
    background: var(--fg);
    color: var(--bg);
  }
  .mail {
    font-size: clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line);
  }
  form {
    display: grid;
    gap: 1.25rem;
    max-width: 520px;
    margin-top: 4rem;
  }
  label {
    display: grid;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  input,
  textarea {
    font: inherit;
    color: var(--fg);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 0.5rem 0;
    outline: none;
  }
  input:focus,
  textarea:focus {
    border-color: var(--accent);
  }
  button {
    justify-self: start;
    font: inherit;
    color: var(--bg);
    background: var(--fg);
    border: 0;
    border-radius: 999px;
    padding: 0.7rem 1.75rem;
    cursor: pointer;
  }
</style>
