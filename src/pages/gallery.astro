---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
---

<BaseLayout title="Gallery" description="Photography.">
  <h1 data-split>Gallery</h1>
  <p class="muted" data-reveal>Frames from the places I wander through.</p>
  <div class="wrap">
    <GalleryGrid />
  </div>
</BaseLayout>

<style>
  .wrap {
    margin-top: 4rem;
  }
</style>
