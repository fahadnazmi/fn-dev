---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { site } from "../data/site";

const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout>
  <section class="hero">
    <h1 class="hero-title" data-split>Projects<span class="hero-title-accent">.</span></h1>
  </section>

  <section>
    <h2 data-reveal>Selected work</h2>
    {featured.map((p) => <ProjectCard slug={p.id} {...p.data} />)}
    <a href="/work" class="more" data-reveal>All projects →</a>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 45svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-title{
    line-height: 1.15;
    font-size: clamp(5rem, 16vw, 14rem);
    letter-spacing: -0.05em;
    margin-left: -0.08em;
  }
  .hero-title-accent{
    line-height: 1.15;
    font-size: clamp(5rem, 16vw, 14rem);
    letter-spacing: -0.05em;
    color: var(--accent);
  }
  section + section {
    margin-top: 6rem;
  }
  h2 {
    margin-bottom: 2rem;
  }
  .more {
    display: inline-block;
    margin-top: 2rem;
  }
</style>
