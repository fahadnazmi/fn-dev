---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const {
  title,
  summary,
  year,
  stack,
  link,
  repo,
  thumbnail
} = entry.data;
---

<BaseLayout title={title} description={summary}>
  <main class="project-page">
    <div class="article-meta">
      <span>PROJECT / {year}</span>
    </div>

    {thumbnail && (
      <div class="project-thumbnail">
        <button
          class="thumbnail-trigger"
          type="button"
          aria-label={`View ${title} image fullscreen`}
        >
          <img
            src={thumbnail}
            alt={`${title} project thumbnail`}
            fetchpriority="high"
            decoding="async"
          />
        </button>
      </div>
    )}

    <dialog class="image-lightbox">
      <button
        class="lightbox-close"
        type="button"
        aria-label="Close preview"
      >
        &times;
      </button>

      <img class="lightbox-image" src="" alt="" />
    </dialog>

    <header class="article-header">
      <h1 class="article-title" data-split>{title}</h1>

      <p class="article-summary" data-reveal>
        {summary}
      </p>

      <div class="article-details" data-reveal>
        {stack.length > 0 && (
          <div>
            <span class="detail-label">TECH</span>
            <span>{stack.join(" · ")}</span>
          </div>
        )}
      </div>
    </header>

    <article class="article-content" data-reveal>
      <Content />
    </article>

    <footer class="article-footer" data-reveal>
      <div class="project-links">
        {link && (
          <a href={link} target="_blank" rel="noopener noreferrer">
            Visit live project ↗
          </a>
        )}

        {repo && (
          <a href={repo} target="_blank" rel="noopener noreferrer">
            View source code ↗
          </a>
        )}
      </div>

      <a href="/work/" class="back-link">← Back to projects</a>
    </footer>
  </main>
</BaseLayout>

<style>
  .project-page {
    padding: 7rem var(--gutter) 5rem;
  }

  .article-meta {
    display: flex;
    justify-content: flex-end;
    width: calc(100% + 2 * var(--gutter));
    margin-left: calc(-1 * var(--gutter));
    padding-bottom: 1.25rem;
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  /* Main thumbnail */

  .project-thumbnail {
    width: calc(100% + 2 * var(--gutter));
    margin-left: calc(-1 * var(--gutter));
    margin-bottom: 4rem;
    overflow: hidden;
  }

  .thumbnail-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: none;
    overflow: hidden;
  }

  .thumbnail-trigger img {
    display: block;
    width: 100%;
    height: clamp(300px, 65vw, 750px);
    object-fit: cover;
    cursor: none;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .thumbnail-trigger:hover img {
    transform: scale(1.04);
  }

  .thumbnail-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* Project section images */

  .article-content :global(img) {
    cursor: none;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .article-content :global(.section-image) {
    overflow: hidden;
    cursor: none;
  }

  .article-content :global(.section-image:hover img) {
    transform: scale(1.04);
  }

  /* Fullscreen image preview */

  .image-lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    padding: 3rem;
    margin: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.95);
    overflow: hidden;
    overscroll-behavior: none;
    cursor: none;
  }

  .image-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.95);
  }

  .lightbox-image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    cursor: none;
  }

  /* Minimal close button */

  .lightbox-close {
    position: fixed;
    top: 1.5rem;
    right: 2rem;
    z-index: 10002;
    padding: 0;
    border: none;
    outline: none;
    background: transparent;
    color: white;
    font-family: inherit;
    font-size: 2.5rem;
    font-weight: 300;
    line-height: 1;
    cursor: none;
    appearance: none;
    box-shadow: none;
  }

  .lightbox-close:hover {
    opacity: 0.6;
  }

  /* Custom cursor above fullscreen preview */

  :global(.cursor) {
    z-index: 10003;
  }

  /* Plus icon inside orange cursor */

  :global(.cursor.image-hover)::after {
    content: "+";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-family: Arial, sans-serif;
    font-size: 17px;
    font-weight: 400;
    line-height: 1;
  }

  .article-header {
    width: calc(100% + 2 * var(--gutter));
    margin-left: calc(-1 * var(--gutter));
  }

  .article-title {
    max-width: 1000px;
    margin: 3rem -0.5rem 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 8rem);
    font-weight: 400;
    line-height: 1.10;
    letter-spacing: -0.055em;
  }

  .article-summary {
    max-width: 650px;
    margin: 3rem 0;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.4;
    color: var(--muted);
  }

  .article-details {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 5rem;
    margin-top: 3rem;
    padding: 1.5rem 0;
    border-block: 1px solid var(--line);
  }

  .article-details > div {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .detail-label {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .article-content {
    width: calc(100% + 2 * var(--gutter));
    margin: 5rem 0 5rem calc(-1 * var(--gutter));
    font-size: 1rem;
    line-height: 1.5;
  }

  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    line-height: 1.10;
  }

  .article-content :global(p) {
    margin: 0 0 1.25rem;
    line-height: 1.5;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
    padding-left: 0.4rem;
    line-height: 1.5;
  }

  .article-content :global(blockquote) {
    margin: 3rem var(--gutter);
    padding-left: 1.5rem;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.10;
  }

  .article-footer {
    width: calc(100% + 2 * var(--gutter));
    margin-left: calc(-1 * var(--gutter));
    padding: 2rem var(--gutter) 0;
    border-top: 1px solid var(--line);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .project-links a,
  .back-link {
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .back-link {
    color: var(--muted);
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .project-page {
      padding-top: 6rem;
    }

    .project-thumbnail {
      margin-bottom: 2.5rem;
    }

    .thumbnail-trigger img {
      height: 55vw;
    }

    .image-lightbox {
      padding: 1rem;
    }

    .lightbox-close {
      top: 1rem;
      right: 1.25rem;
    }

    .article-title {
      margin-top: 2rem;
      line-height: 1.10;
    }

    .article-details {
      gap: 1.5rem;
    }

    .article-content {
      margin-top: 3.5rem;
      margin-bottom: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thumbnail-trigger img,
    .article-content :global(img) {
      transition: none;
    }
  }
</style>

<script>
  const finePointer = window.matchMedia("(pointer: fine)").matches;

  document.querySelectorAll(".project-page").forEach((page) => {
    const lightbox = page.querySelector<HTMLDialogElement>(".image-lightbox");
    const lightboxImage = lightbox?.querySelector<HTMLImageElement>(".lightbox-image");
    const closeButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-close");
    const cursor = document.querySelector<HTMLElement>(".cursor");

    if (!lightbox || !lightboxImage || !closeButton) return;

    // Remember the original cursor position in the DOM.
    const cursorParent = cursor?.parentElement;
    const cursorNextSibling = cursor?.nextSibling;

    // Save the original page scroll position and styles.
    let savedScrollY = 0;
    let originalHtmlOverflow = "";
    let originalBodyOverflow = "";
    let originalBodyPosition = "";
    let originalBodyTop = "";
    let originalBodyWidth = "";

    const lockPageScroll = () => {
      savedScrollY = window.scrollY;

      const html = document.documentElement;
      const body = document.body;

      originalHtmlOverflow = html.style.overflow;
      originalBodyOverflow = body.style.overflow;
      originalBodyPosition = body.style.position;
      originalBodyTop = body.style.top;
      originalBodyWidth = body.style.width;

      html.style.overflow = "hidden";

      body.style.overflow = "hidden";
      body.style.position = "fixed";
      body.style.top = `-${savedScrollY}px`;
      body.style.width = "100%";
    };

    const unlockPageScroll = () => {
      const html = document.documentElement;
      const body = document.body;

      html.style.overflow = originalHtmlOverflow;

      body.style.overflow = originalBodyOverflow;
      body.style.position = originalBodyPosition;
      body.style.top = originalBodyTop;
      body.style.width = originalBodyWidth;

      window.scrollTo(0, savedScrollY);
    };

    // Open fullscreen preview.
    const openPreview = (image: HTMLImageElement) => {
      lightboxImage.src = image.currentSrc || image.src;
      lightboxImage.alt = image.alt;

      // Remove the plus icon for the fullscreen preview.
      cursor?.classList.remove("image-hover");

      // Prevent the background page from scrolling.
      lockPageScroll();

      lightbox.showModal();

      // Move the existing cursor above the dialog.
      if (cursor) {
        lightbox.appendChild(cursor);
      }
    };

    // Close fullscreen preview.
    const closePreview = () => {
      lightbox.close();
    };

    // Main thumbnail click.
    const thumbnail = page.querySelector<HTMLButtonElement>(".thumbnail-trigger");

    thumbnail?.addEventListener("click", () => {
      const image = thumbnail.querySelector("img");
      if (image) openPreview(image);
    });

    // Every image inside the project article.
    const article = page.querySelector(".article-content");

    article?.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof HTMLImageElement)) return;

      openPreview(target);
    });

    // Close button.
    closeButton.addEventListener("click", closePreview);

    // Click outside the image to close.
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) {
        closePreview();
      }
    });

    // Prevent mouse-wheel scrolling inside the fullscreen preview.
    lightbox.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();
      },
      { passive: false }
    );

    // Prevent touch scrolling inside the fullscreen preview.
    lightbox.addEventListener(
      "touchmove",
      (event) => {
        event.preventDefault();
      },
      { passive: false }
    );

    // Restore everything when the preview closes.
    lightbox.addEventListener("close", () => {
      // Return cursor to its original DOM position.
      if (cursor && cursorParent) {
        if (cursorNextSibling && cursorNextSibling.parentNode === cursorParent) {
          cursorParent.insertBefore(cursor, cursorNextSibling);
        } else {
          cursorParent.appendChild(cursor);
        }
      }

      // Restore page scrolling and original position.
      unlockPageScroll();

      // Clear the preview image.
      lightboxImage.src = "";
      lightboxImage.alt = "";

      // Ensure the cursor is plain until the next image hover.
      cursor?.classList.remove("image-hover");
    });

    if (!finePointer || !cursor) return;

    // Show the plus icon when hovering over project images.
    const imageTargets = [
      ...(thumbnail ? [thumbnail] : []),
      ...(article ? Array.from(article.querySelectorAll("img")) : [])
    ];

    imageTargets.forEach((target) => {
      target.addEventListener("mouseenter", () => {
        cursor.classList.add("image-hover");
      });

      target.addEventListener("mouseleave", () => {
        cursor.classList.remove("image-hover");
      });
    });
  });
</script>