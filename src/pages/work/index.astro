---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout>
  <section class="hero">
    <h1 class="hero-title" data-split>
      Projects<span class="hero-title-accent">.</span>
    </h1>

    <div class="hero-image">
      <img
        src="/hero.webp"
        alt="Portfolio hero image"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="work-section">
    <div class="section-heading">ALL PROJECTS</div>

    <div class="project-list">
      {projects.map((p, i) => (
        <ProjectCard
          {...p.data}
          slug={p.id}
          index={i + 1}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 45svh;
    display: grid;
    grid-template-columns: 1fr minmax(180px, 28%);
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
  }

  .hero-title {
    margin-left: -0.08em;
    font-size: clamp(3.5rem, 16vw, 14rem);
    line-height: 1.15;
    letter-spacing: -0.05em;
  }

  .hero-title-accent {
    color: var(--accent);
  }

  .hero-image {
    width: 85%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    justify-self: start;
    align-self: center;
    transform: translate(
      calc(clamp(8px, 3.5vw, 53px) + clamp(2px, 0.4vw, 6px)),
      clamp(-40px, -2.6vw, -12px)
    );
    clip-path: inset(0 0 0 clamp(12px, 1.65vw, 25px));
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-image:hover img {
    transform: scale(1.04);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
    color: var(--muted);
  }

  .project-list {
    max-height: 68svh;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(10, 10, 10, 0.25) transparent;
    border-top: 1px solid rgba(10, 10, 10, 0.15);
    border-bottom: 1px solid rgba(10, 10, 10, 0.15);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 40svh;
      grid-template-columns: 1fr 30%;
      gap: 1rem;
    }

    .hero-title {
      font-size: clamp(3.5rem, 13vw, 6rem);
    }

    .hero-image {
      width: 85%;
      transform: translate(
        clamp(6px, 2vw, 15px),
        clamp(-20px, -2vw, -10px)
      );
    }

    .work-section {
      margin-top: 4rem;
    }

    .project-list {
      max-height: 75svh;
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 2rem;
    }

    .hero-title {
      font-size: clamp(3.5rem, 15vw, 5rem);
    }

    .hero-image {
      width: min(55%, 200px);
      max-width: 240px;
      justify-self: end;
      transform: translate(
        clamp(-5px, -1.05vw, -2px),
        clamp(-8px, -1.7vw, -5px)
      );
    }

    .work-section {
      margin-top: 2.5rem;
    }

    .project-list {
      max-height: 70svh;
    }
  }

  @media (max-width: 360px) {
    .hero-title {
      font-size: 3.2rem;
    }

    .hero-image {
      width: 55%;
      max-width: 180px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image img {
      transition: none;
    }
  }
</style>