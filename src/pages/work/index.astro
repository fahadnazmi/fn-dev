---
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { site } from "../../data/site";

const { heroImage } = site.work;
const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout>
  <section class="hero">
    <h1 class="hero-title" data-split>
      Projects<span class="hero-title-accent">.</span>
    </h1>

    <div class="hero-image">
      <Picture
        src={heroImage.src}
        alt={heroImage.alt}
        widths={[320, 480, 640, 960, 1280, 1600]}
        sizes="(max-width: 768px) 80vw, 64vw"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="work-section">
    <div class="section-heading">ALL PROJECTS</div>

    <div class="project-list">
      {projects.map((p, i) => (
        <ProjectCard
          {...p.data}
          slug={p.id}
          index={i + 1}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 45svh;
    display: grid;
    grid-template-columns: 1fr minmax(180px, 28%);
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
  }

  .hero-image {
    position: relative;
    z-index: 1;
    width: 85%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    justify-self: start;
    align-self: center;
    transform: translate(
      calc(clamp(8px, 3.5vw, 53px) + clamp(2px, 0.4vw, 6px)),
      clamp(-40px, -2.6vw, -12px)
    );
    clip-path: inset(0 0 0 clamp(12px, 1.65vw, 25px));
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
    color: var(--muted);
  }

  .project-list {
    max-height: 68svh;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(10, 10, 10, 0.25) transparent;
    border-top: 1px solid rgba(10, 10, 10, 0.15);
    border-bottom: 1px solid rgba(10, 10, 10, 0.15);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 40svh;
      grid-template-columns: 1fr 30%;
      gap: 1rem;
    }

    .hero-title {
      font-size: clamp(3.5rem, 13vw, 6rem);
    }

    .hero-image {
      width: 85%;
      transform: translate(
        clamp(6px, 2vw, 15px),
        clamp(-20px, -2vw, -10px)
      );
    }

    .work-section {
      margin-top: 4rem;
    }

    .project-list {
      max-height: none;
      overflow: visible;
    }
  }

  @media (max-width: 480px) {
    .hero {
      position: relative;
      min-height: 35svh;
      grid-template-columns: 1fr 30%;
      align-items: center;
      gap: 0;
      padding-top: 2rem;
    }

    .hero-title {
      z-index: 2;
      font-size: clamp(3.2rem, 15vw, 5rem);
      white-space: nowrap;
    }

    .hero-image {
      z-index: 1;
      width: 85%;
      justify-self: end;
      align-self: center;
      margin-right: clamp(5px, 1.05vw, 2px);
      margin-left: 0;
      transform: translateY(clamp(-20px, -2vw, -10px));
      clip-path: inset(0);
    }

    .work-section {
      margin-top: 2.5rem;
    }

  }

  @media (max-width: 360px) {
    .hero-title {
      font-size: 3.2rem;
    }

    .hero-image {
      width: 85%;
    }
  }

</style>